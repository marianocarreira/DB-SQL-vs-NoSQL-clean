def conn = DataSourceElement.getConnection('sqlserver')

def query = '''SELECT PostTypeId, COUNT(*) FROM Posts GROUP BY PostTypeId HAVING COUNT(*) &gt; 1000'''

Statement stmt = null
ResultSet rs = null
try {
    stmt = conn.createStatement()
    rs = stmt.executeQuery(query)    
