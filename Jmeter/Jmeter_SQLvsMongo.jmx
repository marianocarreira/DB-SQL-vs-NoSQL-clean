          <hashTree />
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="MONGO 2.A (Consultas de Agregacion-Num. de Posts por Usuario)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
